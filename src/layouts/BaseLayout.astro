---
import '../styles/atmosphere.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppContact from '../components/WhatsAppContact.astro';
import '../styles/global.css';
import '@fontsource/anton/latin-400.css';
import '@fontsource/inter/latin-400.css';
import '@fontsource/inter/latin-600.css';
import '@fontsource/inter/latin-700.css';
import logo from '../assets/brand/lfx-logo.webp';
interface Props { title: string; description?: string; noindex?: boolean; article?: {title: string; datePublished: string; image?: string} }
const { title, description = 'Lefaucheux Esports. Singapore roots, global ambition. Meet our MLBB divisions, discover our story and become part of the movement.', noindex = false, article } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/assets/og-lfx.webp', Astro.site);
const organization = { '@context': 'https://schema.org', '@type': 'Organization', name: 'Lefaucheux Esports', url: Astro.site?.href, logo: new URL(logo.src, Astro.site).href, foundingDate: '2024', email: 'lefaucheux.esports@gmail.com', telephone: '+6587763403' };
const breadcrumbs = { '@context':'https://schema.org', '@type':'BreadcrumbList', itemListElement: [{ '@type':'ListItem', position:1, name:'Home', item:Astro.site?.href }, ...(Astro.url.pathname !== '/' ? [{ '@type':'ListItem', position:2, name:title, item:canonical.href }] : [])] };
---
<!doctype html><html lang="en"><head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width" /><meta name="theme-color" content="#080808" /><title>{title === 'Home' ? 'Lefaucheux Esports — Built from passion. Driven by ambition.' : `${title} | Lefaucheux Esports`}</title><meta name="description" content={description} /><link rel="canonical" href={canonical} /><link rel="icon" type="image/webp" href="/favicon.webp" />{noindex && <meta name="robots" content="noindex" />}<meta property="og:title" content={`${title} | Lefaucheux Esports`} /><meta property="og:description" content={description} /><meta property="og:type" content={article ? 'article' : 'website'} /><meta property="og:url" content={canonical} /><meta property="og:image" content={ogImage} /><meta property="og:image:alt" content="Lefaucheux Esports official logo" /><meta name="twitter:card" content="summary_large_image" /><script type="application/ld+json" set:html={JSON.stringify(organization).replace(/</g, '\\u003c')} /><script type="application/ld+json" set:html={JSON.stringify(breadcrumbs).replace(/</g, '\\u003c')} />{article && <script type="application/ld+json" set:html={JSON.stringify({'@context':'https://schema.org','@type':'Article',headline:article.title,datePublished:article.datePublished,description,url:canonical.href, ...(article.image ? {image:article.image} : {}),publisher:{'@type':'Organization',name:'Lefaucheux Esports'}}).replace(/</g,'\\u003c')} />}<slot name="head" /></head><body><a class="skip-link" href="#main">Skip to content</a><Header /><main id="main"><slot /></main><Footer /><WhatsAppContact /></body></html>

