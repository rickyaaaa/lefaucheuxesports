---
import JerseyShowcase from "../components/JerseyShowcase.astro";
import Atmosphere from "../components/Atmosphere.astro";
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Button from '../components/Button.astro';
import { serviceTiers } from '../data/content';
---
<BaseLayout title="Services" description="Discover LFX website packages — Basic, Standard and Premium — and custom jerseys for teams, communities, organizations and individuals. Contact LFX to discuss your project and a quote."><PageHero title="YOUR VISION." accent="LET’S BUILD IT." breadcrumb="Services" description="Website and custom jersey inquiries. Start with a conversation about what you need."><div class="jump-links"><a href="#websites">Website packages</a><a href="#jersey">Custom jerseys</a></div></PageHero><section class="section" id="websites"><Atmosphere variant="signal" /><div class="container"><div class="section-top"><h2>WEBSITE <span class="crimson">PACKAGES.</span></h2><p>Basic, Standard or Premium.<br />Get in touch to discuss the right package for your project.</p></div><div class="tiers">{serviceTiers.map(tier=><article class="tier"><h3>{tier.title}</h3><p>Contact LFX for package details, scope and a tailored quote.</p>{tier.features.length>0&&<ul>{tier.features.map(feature=><li>{feature}</li>)}</ul>}{tier.priceLabel&&<p>{tier.priceLabel}</p>}<Button href={`/join-us/?interest=website-${tier.slug}`} secondary>Request a quote</Button></article>)}</div><p class="fine-print package-note">Package specifications and pricing are available by inquiry.</p></div></section><section class="section jersey" id="jersey"><Atmosphere variant="weave" /><div class="container"><div class="split"><h2>WEAR THE<br /><span class="crimson">IDENTITY.</span></h2><div class="stack"><h3>Custom Jerseys</h3><p>Custom jerseys for teams, communities, organizations and individuals. Contact LFX to discuss your design, sizing, quantity and a quote.</p><p class="fine-print">Our LFX Home, Away and MPL SG S12 designs below are examples of our jersey work. Get in touch to discuss a design for you or your team.</p><Button href="/join-us/?interest=jersey">Enquire about custom jerseys</Button></div></div><JerseyShowcase /></div></section></BaseLayout>
<style>.tiers{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:20px}.tier{background:var(--color-surface);padding:36px 28px;border-top:2px solid var(--color-crimson);display:flex;align-items:start;flex-direction:column}.tier h3{font-size:36px}.tier p{font-size:14px;margin:24px 0 36px}.tier .button{margin-top:auto;gap:20px}.package-note{margin-top:24px}.jersey{background:var(--color-ink)}@media(max-width:850px){.tiers{grid-template-columns:1fr}.tier{padding:32px}.tier p{margin:18px 0 24px}}</style>
