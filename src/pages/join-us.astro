---
import Atmosphere from "../components/Atmosphere.astro";
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Arrow from '../components/Arrow.astro';
import { interests, site } from '../data/site';
---
<BaseLayout title="Join Us" description="Contact Lefaucheux Esports for sponsorship, collaboration, partnerships, tournaments, LFX Academy, websites and jersey inquiries."><PageHero title="JOIN THE" accent="MOVEMENT." breadcrumb="Join Us" description="A shared ambition starts with a conversation. Tell us how you’d like to be part of LFX." /><section class="section"><Atmosphere variant="signal" /><div class="container contact-layout"><div><h2>FIND YOUR<br /><span class="crimson">PLACE WITH LFX.</span></h2><div class="opportunities">{interests.slice(0,5).map(([value,label])=><a href={`?interest=${value}#enquiry`} data-interest={value}>{label}<Arrow diagonal /></a>)}</div><div class="contact-details"><h3>Direct contact</h3><a href={`mailto:${site.email}`}>{site.email}</a><a href={`tel:${site.phoneHref}`}>{site.phone}</a><p>Singapore<br />Instagram: {site.instagram}<br />TikTok: {site.tiktok}</p></div></div><div class="enquiry" id="enquiry"><h2>LET’S <span class="crimson">TALK.</span></h2><p>Choose your interest, then send your inquiry directly to our team by email.</p><label for="interest">I’m interested in</label><select id="interest" name="interest">{interests.map(([value,label])=><option value={value}>{label}</option>)}</select><a class="button" id="email-enquiry" href={`mailto:${site.email}?subject=${encodeURIComponent('LFX inquiry — Sponsorship')}`}>Start an email <Arrow /></a><p class="fine-print">Opens your email app. Include your name, organization (if applicable), and what you have in mind.</p><div class="email-fallback"><p>Prefer to write it yourself?</p><a href={`mailto:${site.email}`}>{site.email}</a></div></div></div></section></BaseLayout>
<script>
  const select=document.querySelector<HTMLSelectElement>('#interest');
  const email=document.querySelector<HTMLAnchorElement>('#email-enquiry');
  function updateInterest(value?: string|null){
    if(!select||!email)return;
    if(value && Array.from(select.options).some(option=>option.value===value)) select.value=value;
    const label=select.selectedOptions[0].textContent??'General inquiry';
    email.href=`mailto:lefaucheux.esports@gmail.com?subject=${encodeURIComponent(`LFX inquiry — ${label}`)}&body=${encodeURIComponent('Hello LFX,\n\nMy name is: \nOrganization (optional): \n\nI would like to discuss '+label+'.\n\n')}`;
  }
  updateInterest(new URLSearchParams(location.search).get('interest'));
  select?.addEventListener('change',()=>updateInterest());
  document.querySelectorAll<HTMLAnchorElement>('[data-interest]').forEach(link=>link.addEventListener('click',event=>{event.preventDefault();updateInterest(link.dataset.interest);history.replaceState(null,'',link.href);document.getElementById('enquiry')?.scrollIntoView({behavior:matchMedia('(prefers-reduced-motion: reduce)').matches?'instant':'smooth'});select?.focus({preventScroll:true});}));
</script>
<style>.contact-layout{display:grid;grid-template-columns:1fr 1fr;gap:88px;align-items:start}.contact-layout h2{font-size:clamp(34px,3.5vw,46px)}.opportunities{margin:36px 0;display:grid}.opportunities a{display:flex;align-items:center;justify-content:space-between;gap:20px;border-bottom:1px solid var(--color-border-dark);padding:20px 0;font-size:14px}.opportunities a:hover{color:var(--color-crimson-hover)}.contact-details{padding-top:12px}.contact-details h3{font-size:22px;margin-bottom:20px}.contact-details>a{display:block;font-size:14px;margin-bottom:14px;overflow-wrap:anywhere}.contact-details p{margin-top:22px;font-size:12px}.enquiry{background:var(--color-surface);border-top:3px solid var(--color-crimson);padding:42px 36px}.enquiry>p{margin-top:20px;font-size:14px}.enquiry label{display:block;margin:32px 0 12px;font-size:12px;font-weight:600}.enquiry select{display:block;width:100%;height:52px;background:var(--color-black-russian);color:white;border:1px solid #ffffff30;padding:0 14px;border-radius:2px;cursor:pointer}.enquiry>.button{margin-top:24px;display:flex}.enquiry>p.fine-print{font-size:11px}.email-fallback{border-top:1px solid var(--color-border-dark);margin-top:32px;padding-top:24px}.email-fallback p{font-size:11px;margin-bottom:6px}.email-fallback a{font-size:12px;overflow-wrap:anywhere;text-decoration:underline}@media(max-width:900px){.contact-layout{gap:40px}}@media(max-width:767px){.contact-layout{grid-template-columns:1fr}.enquiry{padding:32px 22px}}</style>
