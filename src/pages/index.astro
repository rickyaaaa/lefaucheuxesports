---
import Atmosphere from "../components/Atmosphere.astro";
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import DivisionCard from '../components/DivisionCard.astro';
import Vision from '../components/Vision.astro';
import JoinBanner from '../components/JoinBanner.astro';
import Partners from '../components/Partners.astro';
import ladies from '../assets/team/ladies-lineup.png';
import sg from '../assets/team/sg-s12.png';
import sgDivisions from '../assets/team/mpl-home-05.webp';
---
<BaseLayout title="Home">
  <section class="home-hero"><div class="hero-art" aria-hidden="true"><Atmosphere variant="arena" /><span class="hero-word">FEARLESS</span><Image src={ladies} alt="" widths={[800,1200,1774]} sizes="(max-width: 767px) 100vw, 75vw" loading="eager" fetchpriority="high" /></div><div class="container hero-inner"><div class="hero-copy"><h1><span>WELCOME TO</span><strong>LEFAUCHEUX</strong><span>ESPORTS</span></h1><p>Singapore roots. Global ambition.<br />United by passion for Mobile Legends: Bang Bang. Built to go beyond.</p><Button href="/profile/">Discover LFX</Button></div></div></section>
  <section class="section home-about"><Atmosphere variant="weave" /><div class="container split"><figure class="about-image"><Image src={sg} alt="Official LFX Singapore roster promotional artwork" widths={[400,650,900]} sizes="(max-width: 767px) 90vw, 42vw" /></figure><div class="stack about-copy"><h2><span class="crimson">BUILT FROM PASSION.</span><br />DRIVEN BY AMBITION.</h2><p>Founded in Singapore in 2024, Lefaucheux Esports brings together a shared love for competition and the determination to grow.</p><p>Across our Singapore and Indonesia Ladies divisions, we build on discipline, loyalty and resilience. One organization. One fearless identity.</p><Button href="/profile/" secondary>Discover our story</Button></div></div></section>
  <section class="section light home-divisions"><Atmosphere variant="light" /><div class="container"><div class="section-top"><h2>OUR <span class="crimson">DIVISIONS.</span></h2></div><span class="division-watermark" aria-hidden="true">LEFAUCHEUX</span><div class="division-grid"><DivisionCard title="MPL SG" href="/esports/#mpl-sg" image={sgDivisions} alt="LFX MPL Singapore team in official crimson and black jerseys, client-selected group photo" contain /><DivisionCard title="MLBB ID LADIES" href="/esports/#id-ladies" image={ladies} alt="Five LFX ID Ladies players in crimson and black jerseys" contain /></div></div></section>
  <Partners /><Vision /><JoinBanner />
</BaseLayout>
<script>
  import '../scripts/home-motion';
</script>
<style>
  .home-hero{position:relative;isolation:isolate;overflow:hidden;background:#100b13;min-height:660px;display:flex;align-items:center}.home-hero:before{content:'';position:absolute;inset:0;background:linear-gradient(90deg,#100b13 0%,#100b13ee 27%,#100b1340 64%,#100b1310);z-index:-1}.hero-inner{position:relative;z-index:3;padding-block:80px 110px;pointer-events:none}.hero-copy{max-width:510px;pointer-events:auto}.hero-copy h1{font-size:clamp(54px,5.4vw,76px);line-height:1.08;letter-spacing:0}.hero-copy h1 span,.hero-copy h1 strong{display:block;font-weight:400}.hero-copy h1 strong{color:var(--color-crimson)}.hero-copy p{margin:26px 0 30px;max-width:355px;color:#c5bec8;font-size:14px}.hero-art{position:absolute;inset:0 0 0 30%;z-index:-2;background:linear-gradient(135deg,#3b0a1d,#141321 60%);overflow:hidden}.hero-art:after{content:'';position:absolute;inset:0;background:linear-gradient(0deg,#100b13 1%,transparent 35%)}.hero-art img{position:absolute;bottom:0;right:-6%;height:90%;width:116%;max-width:none;object-fit:contain;object-position:center bottom}.hero-word{position:absolute;top:24px;right:-12px;font:clamp(100px,13vw,190px)/1 var(--font-display);color:#ffffff05;letter-spacing:0}.home-about{background:var(--color-black-russian)}.about-image{margin:0;position:relative;padding:0 24px 18px 0}.about-image:after{content:'';position:absolute;right:0;top:25px;bottom:0;width:75%;border:1px solid #e2012d66;z-index:0}.about-image img{width:100%;aspect-ratio:1.1;object-fit:cover;object-position:center 30%;position:relative;z-index:1;border-radius:3px}.about-copy h2{font-size:clamp(32px,3.5vw,46px);line-height:1.2}.about-copy p{font-size:14px}.home-divisions{position:relative;overflow:hidden}.home-divisions .container{position:relative}.home-divisions .section-top{justify-content:center;text-align:center}.division-watermark{position:absolute;top:62px;left:50%;transform:translateX(-50%);text-align:center;font:clamp(80px,13.5vw,180px)/1 var(--font-display);color:var(--color-pink-watermark);opacity:.32;white-space:nowrap;pointer-events:none}.division-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:20px;position:relative;z-index:1;padding-top:28px}
  @media(min-width:1600px){.hero-art img{right:0;width:100%}}
  @media(max-width:1099px){.home-hero{min-height:610px}.hero-copy{max-width:450px}.hero-copy h1{font-size:62px}.hero-art{left:28%}.hero-art img{right:-22%;width:140%}.hero-copy p{max-width:300px}.about-copy h2{font-size:34px}}
  @media(max-width:767px){.home-hero{min-height:780px;align-items:start}.hero-inner{padding-block:48px 350px}.hero-copy{max-width:100%}.hero-copy h1{font-size:clamp(42px,10.8vw,66px)}.hero-copy p{font-size:13px;margin:22px 0;max-width:330px}.hero-art{left:0;top:360px;bottom:0;background:linear-gradient(135deg,#310c20,#141321)}.hero-art img{height:100%;width:112%;right:-6%;object-fit:contain}.hero-word{font-size:100px;top:25px}.home-hero:before{background:linear-gradient(180deg,#100b13 10%,#100b1300 65%)}.division-grid{grid-template-columns:1fr;padding-top:8px;gap:16px}.division-watermark{top:52px;font-size:90px}.about-image{max-width:550px}.about-copy h2{font-size:36px}}
</style>
<style>
  @media(max-width:767px){
    .home-hero{min-height:0;display:flex;flex-direction:column;align-items:stretch}
    .home-hero:before{display:none}
    .hero-inner{order:1;padding-block:48px 32px}
    .hero-copy p{font-size:14px}
    .hero-art{order:2;position:relative;inset:auto;width:100%;height:auto;aspect-ratio:1.8;z-index:0}
    .hero-art img{height:100%;width:100%;right:0;object-fit:contain}
    .hero-word{top:0}
    
  }
</style>

