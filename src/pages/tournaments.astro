---
import Atmosphere from "../components/Atmosphere.astro";
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Button from '../components/Button.astro';
import { tournaments, casters, overlays } from '../data/content';
import { Image } from 'astro:assets';
---
<BaseLayout title="Tournaments" description="Explore LFX tournament activities across Singapore, Malaysia and Indonesia, plus tournament overlay and caster portfolios."><PageHero title="BRING THE" accent="COMPETITION." breadcrumb="Tournaments" description="Events, community and the people behind the broadcast. Explore tournament activities with LFX."><div class="jump-links"><a href="#regions">Regional events</a><a href="#overlays">Tournament overlays</a><a href="#casters">Casters</a></div></PageHero><section class="section" id="regions"><Atmosphere variant="signal" /><div class="container"><div class="section-top"><h2>ACROSS <span class="crimson">BORDERS.</span></h2><p>Singapore. Malaysia. Indonesia.<br />Regional activities and event announcements.</p></div><div class="regions">{([['SG','Singapore'],['MY','Malaysia'],['ID','Indonesia']] as const).map(([code,name])=><section class="region"><h3>{name}</h3>{tournaments.filter(t=>t.published&&t.region===code).length ? tournaments.filter(t=>t.published&&t.region===code).map(t=><article class="event"><h4>{t.title}</h4><p>{t.date ?? 'Event dates and public details have not been announced.'}</p><span class="fine-print">Referenced in the LFX company profile brief.</span></article>) : <p>No public event announcements yet.</p>}</section>)}</div><Button href="/join-us/?interest=tournaments">Enquire about tournaments</Button></div></section><section class="section portfolio" id="overlays"><Atmosphere variant="weave" /><div class="container split"><h2>TOURNAMENT<br /><span class="crimson">OVERLAYS.</span></h2><div>{overlays.filter(o=>o.published).length ? overlays.filter(o=>o.published).map(o=><figure><Image src={o.image} alt={o.title} width={800}/><figcaption>{o.title}</figcaption></figure>) : <div class="stack"><p>Our overlay showcase will feature approved tournament design work when it is available.</p><Button href="/join-us/?interest=tournaments" secondary>Discuss an event</Button></div>}</div></div></section><section class="section" id="casters"><Atmosphere variant="signal" /><div class="container split"><h2>VOICES OF<br /><span class="crimson">THE GAME.</span></h2><div>{casters.filter(c=>c.published).length ? casters.filter(c=>c.published).map(c=><article><h3>{c.name}</h3><p>{c.language}</p>{c.url&&<a href={c.url}>View profile</a>}</article>) : <div class="stack"><p>Caster profiles will be shared once the lineup and publication details are confirmed.</p><Button href="/join-us/?interest=tournaments" secondary>Connect with LFX</Button></div>}</div></div></section></BaseLayout>
<style>.regions{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:32px;margin-bottom:36px}.region{padding:24px 0;border-top:2px solid var(--color-crimson)}.region h3{font-size:28px;margin-bottom:20px}.region p{font-size:13px}.event h4{font-size:15px;font-weight:600;margin:0 0 12px}.event>span{display:block;color:var(--color-text-muted);margin-top:14px;font-size:10px}.portfolio{background:var(--color-ink)}@media(max-width:767px){.regions{grid-template-columns:1fr;gap:20px}}</style>
