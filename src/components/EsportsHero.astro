---
import { Image } from 'astro:assets';
import Atmosphere from './Atmosphere.astro';
import SingaporeLineup from './SingaporeLineup.astro';
import ladies from '../assets/team/ladies-lineup.png';
---
<section class="page-hero esports-hero">
  <Atmosphere variant="arena" />
  <div class="banner-portraits" aria-hidden="true">
    <div class="banner-sg"><SingaporeLineup decorative /></div>
    <Image class="banner-ladies" src={ladies} alt="" widths={[400,650,900]} sizes="35vw" loading="eager" />
  </div>
  <div class="container">
    <nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><span>Esports</span></nav>
    <div class="banner-copy">
      <h1>OUR <span class="crimson">TEAMS.</span></h1>
      <p>Two divisions. One Lefaucheux.</p>
      <nav class="jump-links" aria-label="Esports divisions"><a href="#mpl-sg">MPL Singapore</a><a href="#id-ladies">MLBB Ladies</a></nav>
    </div>
  </div>
</section>
<style>
  .esports-hero{padding:32px 0 64px;background:var(--color-black-russian);border-bottom:1px solid var(--color-border-dark)}
  .breadcrumbs{display:flex;gap:14px;font-size:11px;color:var(--color-text-muted)}
  .breadcrumbs a:hover{color:var(--color-white)}
  .banner-copy{text-align:center;position:relative;padding-top:40px}
  h1{font-size:clamp(48px,6.5vw,88px);line-height:1.1;margin-inline:auto}
  .banner-copy p{margin:20px auto 0}
  .jump-links{justify-content:center;margin-top:28px}
  .banner-portraits{position:absolute;inset:0;z-index:0;overflow:hidden;pointer-events:none}
  .banner-sg,.banner-ladies{position:absolute;bottom:0;width:34%;height:95%;opacity:.24;mask-image:linear-gradient(to bottom,#000 45%,transparent)}
  .banner-sg{left:0;display:flex;align-items:end}.banner-ladies{right:-3%;object-fit:contain;object-position:center bottom}
  @media(max-width:767px){.esports-hero{padding:28px 0 48px}.banner-copy{padding-top:36px}.banner-portraits{display:none}.banner-copy p{font-size:14px}.jump-links{margin-top:24px}}
</style>
