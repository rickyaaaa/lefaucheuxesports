---
import Atmosphere from "./Atmosphere.astro";
import Button from './Button.astro';
---
<section class="join-banner"><Atmosphere variant="arena" /><div class="container"><h2>BE PART OF<br />SOMETHING <span class="crimson">BIGGER.</span></h2><p>Players. Partners. Possibilities.<br />Your next chapter could start with LFX.</p><Button href="/join-us/">Join us</Button></div></section>
<style>.join-banner{position:relative;isolation:isolate;overflow:hidden;background:var(--color-ink);padding:88px 0;text-align:center}.join-banner:before,.join-banner:after{content:'';position:absolute;z-index:-1;top:-35%;height:180%;width:22%;border:1px solid #e2012d36;transform:skew(-26deg)}.join-banner:before{left:-7%;background:#e2012d09}.join-banner:after{right:-7%;border-width:1px 24px 1px 1px}.join-banner h2{font-size:clamp(36px,4.5vw,58px);line-height:1.15}.join-banner p{margin:24px auto 28px}.join-banner .button{margin:auto}</style>
