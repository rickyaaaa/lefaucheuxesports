---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import Arrow from './Arrow.astro';
interface Props { entry: CollectionEntry<'news'> }
const { entry } = Astro.props;
---
<article data-category={entry.data.category} class="news-card">{entry.data.cover && <Image src={entry.data.cover} alt={entry.data.coverAlt!} width={700} />}<p class="news-meta">{entry.data.category} · <time datetime={entry.data.pubDate.toISOString()}>{entry.data.pubDate.toLocaleDateString('en-SG',{day:'numeric',month:'short',year:'numeric',timeZone:'Asia/Jakarta'})}</time></p><h2><a href={`/news/${entry.id}/`}>{entry.data.title}</a></h2><p>{entry.data.description}</p><a class="text-link" href={`/news/${entry.id}/`}>Read article <Arrow /></a></article>
<style>.news-card{border-top:1px solid var(--color-border-dark);padding:28px 0}.news-card img{width:100%;aspect-ratio:16/9;object-fit:cover;margin-bottom:24px}.news-meta{font-size:11px;color:var(--color-text-muted);margin-bottom:16px}.news-card h2{font-size:30px;margin-bottom:16px}.news-card>.text-link{margin-top:20px}.news-card h2 a:hover{color:var(--color-crimson-hover)}</style>
