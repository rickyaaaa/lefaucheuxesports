---
import { Image } from 'astro:assets';
import official from '../assets/jerseys/official-mpl-sg-s12.png';
import home from '../assets/jerseys/home.jpg';
import away from '../assets/jerseys/away.jpg';
---
<div class="jersey-showcase">
  <figure class="jersey-feature">
    <Image src={official} alt="Official LFX MPL Singapore S12 jersey artwork in crimson and black" widths={[400,700,1000]} sizes="(max-width: 767px) 90vw, 40vw" />
    <figcaption><strong>MPL SG S12</strong><span>Official jersey artwork</span></figcaption>
  </figure>
  <div class="jersey-designs">
    <figure>
      <Image src={home} alt="LFX Home jersey design, front and back, with crimson and black panels" widths={[400,800,1200]} sizes="(max-width: 767px) 90vw, 50vw" />
      <figcaption><strong>HOME</strong><span>Front &amp; back design</span></figcaption>
    </figure>
    <figure>
      <Image src={away} alt="LFX Away jersey design, front and back, with gold and white panels" widths={[400,800,1200]} sizes="(max-width: 767px) 90vw, 50vw" />
      <figcaption><strong>AWAY</strong><span>Front &amp; back design</span></figcaption>
    </figure>
  </div>
</div>
<style>
  .jersey-showcase{display:grid;grid-template-columns:minmax(0,.82fr) minmax(0,1.18fr);gap:28px;margin-top:48px;align-items:start}
  figure{margin:0;overflow:hidden;border-radius:var(--radius-small);background:var(--color-surface-2)}
  figure img{width:100%;height:auto;object-fit:contain}
  .jersey-feature img{aspect-ratio:4/5}.jersey-designs{display:grid;gap:24px}
  .jersey-designs img{aspect-ratio:1600/716;background:#fff}
  figcaption{display:flex;justify-content:space-between;align-items:center;gap:16px;padding:18px 20px}
  figcaption strong{font-family:var(--font-display);font-size:22px;font-weight:400}
  figcaption span{font-size:11px;line-height:1.6;color:var(--color-text-muted)}
  @media(max-width:767px){.jersey-showcase{grid-template-columns:1fr;gap:24px;margin-top:32px}.jersey-feature{max-width:480px;width:100%;margin-inline:auto}figcaption{padding:16px}figcaption strong{font-size:20px}}
</style>
