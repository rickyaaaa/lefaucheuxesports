---
import { site } from '../data/site';
---
<a class="whatsapp-contact" href={site.whatsapp} target="_blank" rel="noopener noreferrer" aria-label={`Contact LFX on WhatsApp at ${site.phone} (opens in a new tab)`} title="Chat with LFX on WhatsApp">
  <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false"><path d="M20.52 3.48A11.89 11.89 0 0 0 12.05 0C5.46 0 .1 5.36.1 11.95c0 2.1.55 4.15 1.6 5.95L0 24l6.28-1.65a11.94 11.94 0 0 0 5.77 1.47h.01C18.65 23.82 24 18.46 24 11.87c0-3.18-1.24-6.17-3.48-8.39ZM12.06 21.8a9.9 9.9 0 0 1-5.05-1.38l-.36-.21-3.73.98 1-3.64-.24-.38a9.87 9.87 0 0 1-1.52-5.22c0-5.48 4.45-9.93 9.94-9.93a9.86 9.86 0 0 1 7.02 2.91 9.86 9.86 0 0 1 2.91 7.02c0 5.48-4.45 9.85-9.97 9.85Zm5.45-7.39c-.3-.15-1.77-.87-2.04-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.17-.17.2-.35.22-.65.07-.3-.15-1.26-.46-2.4-1.48-.89-.79-1.49-1.77-1.66-2.07-.17-.3-.02-.46.13-.61.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.08-.15-.67-1.62-.92-2.22-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.8.37-.27.3-1.04 1.02-1.04 2.49s1.07 2.89 1.22 3.09c.15.2 2.1 3.2 5.08 4.49.71.3 1.26.49 1.69.63.71.22 1.36.19 1.87.12.57-.09 1.77-.72 2.02-1.42.25-.7.25-1.3.17-1.42-.07-.12-.27-.2-.57-.35Z" /></svg>
</a>
<style>
  .whatsapp-contact{position:fixed;right:max(24px,env(safe-area-inset-right));bottom:max(24px,env(safe-area-inset-bottom));z-index:40;width:56px;height:56px;display:flex;align-items:center;justify-content:center;border-radius:50%;background:#087f45;color:var(--color-white);box-shadow:0 4px 16px #0005;transition:background var(--duration-fast)}
  .whatsapp-contact:hover{background:#066638}
  .whatsapp-contact:focus-visible{outline:3px solid var(--color-white);outline-offset:4px}
  @media(max-width:767px){.whatsapp-contact{right:max(16px,env(safe-area-inset-right));bottom:max(16px,env(safe-area-inset-bottom));width:52px;height:52px}}
</style>
