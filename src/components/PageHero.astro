---
import Atmosphere from "./Atmosphere.astro";
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props { title: string; accent: string; description: string; breadcrumb: string; visual?: ImageMetadata; visualAlt?: string }
const { title, accent, description, breadcrumb, visual, visualAlt = '' } = Astro.props;
---
<section class:list={['page-hero', {'with-visual': visual}]}><Atmosphere variant="arena" /><div class="container"><nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><span>{breadcrumb}</span></nav><div class="hero-content"><div class="hero-copy"><h1>{title}<br /><span class="crimson">{accent}</span></h1><p>{description}</p><slot /></div>{visual && <Image class="hero-visual" src={visual} alt={visualAlt} widths={[500,800,1200]} sizes="(max-width: 767px) 90vw, 45vw" loading="eager" />}</div></div></section>
<style>.page-hero{padding:38px 0 68px;background:var(--color-black-russian);border-bottom:1px solid var(--color-border-dark);position:relative;overflow:hidden}.page-hero:after{content:'';position:absolute;width:32%;height:140%;right:-16%;top:-15%;border:1px solid #e2012d44;transform:skew(-24deg);pointer-events:none}.breadcrumbs{display:flex;gap:14px;font-size:11px;color:var(--color-text-muted);margin-bottom:42px}.breadcrumbs a:hover{color:white}.page-hero h1{font-size:clamp(40px,5vw,70px);line-height:1.1;max-width:900px}.page-hero p{max-width:660px;margin-top:24px}.page-hero :global(.jump-links){margin-top:32px}</style>
<style>.with-visual .hero-content{display:grid;grid-template-columns:minmax(0,1.1fr) minmax(0,1fr);gap:32px;align-items:center}.hero-visual{width:100%;height:auto;align-self:end}.with-visual .hero-copy{position:relative;z-index:1}.with-visual h1{font-size:clamp(40px,4.5vw,64px)}@media(max-width:767px){.with-visual .hero-content{grid-template-columns:1fr;gap:32px}.with-visual{padding-bottom:0}.hero-visual{max-width:560px;margin-inline:auto}.with-visual h1{font-size:clamp(40px,8vw,64px)}}</style>
